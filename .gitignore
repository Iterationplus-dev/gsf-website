/.idea
/.nova
/.vscode
/.zed
.DS_Store
Thumbs.db
desktop.ini

# Agent and tooling scratch.
/.claude
/.phpunit.cache

# Deployment artefacts built from the working tree. These are produced on
# demand and would otherwise be committed as large binary blobs.
/deploy
/*.zip
