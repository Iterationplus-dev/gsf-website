# Production environment template
# ------------------------------------------------------------------
# Copy this to ".env" in the application root, then fill in the five
# values marked FILL IN. Everything else is already set correctly for
# production and should not need changing.
#
#     cp production.env.template .env
#     php artisan key:generate
#
# This file contains no credentials. Never commit the resulting .env,
# and never place it inside public/ or public_html/.
# ------------------------------------------------------------------

APP_NAME="Global Support Foundation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://globalsupportfoundation.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database -------------------------------------------------- FILL IN
# Create the database and user in cPanel → MySQL Databases. cPanel
# prefixes both with your account name, e.g. "gsfuser_gsf".
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions, cache and the queue all run on the database, so no Redis
# is required. The queue is drained by cron — see DEPLOY-CPANEL.md §7.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail ------------------------------------------------------ FILL IN
# Create the mailbox in cPanel → Email Accounts, then use the details
# from "Connect Devices". Without this, no acknowledgement, receipt or
# newsletter confirmation is ever delivered.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
# Port 465 uses implicit SSL, which this Laravel version expects as
# MAIL_SCHEME=smtps. For STARTTLS on port 587, use MAIL_PORT=587 and
# leave MAIL_SCHEME empty. (MAIL_ENCRYPTION is from older Laravel and
# is ignored here.)
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="info@globalsupportfoundation.org"
MAIL_FROM_NAME="${APP_NAME}"

# Where enquiry and membership notifications are sent.
ADMIN_NOTIFICATION_EMAIL="info@globalsupportfoundation.org"

# --- Cloudinary ------------------------------------------------ FILL IN
# The cloud name is already correct; the key and secret are in your
# Cloudinary dashboard under Settings → API Keys.
CLOUDINARY_CLOUD_NAME=dt6xndtv
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gsf

# Governs where NEW uploads go. Existing images record their own disk
# and resolve either way. Left as "public", uploads land on local disk
# and are lost on the next deployment.
MEDIA_DRIVER=cloudinary

# --- Donations ------------------------------------------------- FILL IN
# Leave DONATIONS_ENABLED=false until the live Paystack key is in place;
# the donate page then explains that giving is temporarily unavailable
# rather than failing at the payment step.
DONATIONS_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCIES=NGN

# --- Optional --------------------------------------------------------
# Privacy-conscious analytics. Leave empty to load no analytics at all.
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_URL=

# Require subscribers to confirm by email before they receive anything.
NEWSLETTER_DOUBLE_OPT_IN=true

VITE_APP_NAME="${APP_NAME}"
